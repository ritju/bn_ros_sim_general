<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="bn_sim_default">
    <static>true</static>
    <link name="walls">>
      <visual name="walls_v">
        <geometry>
          <mesh>
            <uri>model://bn_sim/meshes/walls.stl</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="walls_c">
        <geometry>
          <mesh>
            <uri>model://bn_sim/meshes/walls.stl</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
    <link name="charger">
      <visual name="marker_v">
        <pose>0 0 0.12 0 0 0</pose> 
        <geometry>
          <mesh>
            <uri>model://bn_sim/meshes/marker.stl</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <visual name="charger_v">
        <pose>0 0 0.12 0 0 0</pose> 
        <geometry>
          <mesh>
            <uri>model://bn_sim/meshes/charge.stl</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="charger_c">
        <pose>0 0 0.12 0 0 0</pose> 
        <geometry>
          <mesh>
            <uri>model://bn_sim/meshes/charge.stl</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
